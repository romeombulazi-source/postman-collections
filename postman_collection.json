    {
      "name": "post auth/refresh (refresh token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// post auth/refresh (refresh token)",
              "",
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response time is under 2000ms', function () {",
              "  pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test('Refresh response returns token fields', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.be.an('object');",
              "  pm.expect(json).to.have.property('token');",
              "  pm.expect(json.token).to.be.a('string').and.not.be.empty;",
              "  if (json.refreshToken !== undefined) {",
              "    pm.expect(json.refreshToken).to.be.a('string');",
              "  }",
              "});",
              "",
              "// Persist tokens",
              "try {",
              "  const json = pm.response.json();",
              "  if (json.token) pm.environment.set('accessToken', json.token);",
              "  if (json.refreshToken) pm.environment.set('refreshToken', json.refreshToken);",
              "} catch (e) {}",
              ""
            ]
          }
        }
